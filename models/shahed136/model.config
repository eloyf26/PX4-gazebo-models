<?xml version="1.0"?>
<model>
  <name>Shahed-136</name>
  <version>1.0</version>
  <sdf version='1.9'>model.sdf</sdf>

  <author>
   <name>Thalanor / Eloy</name>
  </author>

  <description>
    Simplified box-geometry model of a Shahed-136 (Geran-2) delta-wing
    pusher-prop loitering munition, used as the TARGET the STING interceptor
    pursues. Adapted from PX4 advanced_plane (AdvancedLiftDrag stack): tailless
    delta, rear pusher rotor, 2 elevons + 2 winglet rudders. Phase-1 geometry is
    intentionally simple boxes ("first fly, then beautify").
  </description>
</model>
